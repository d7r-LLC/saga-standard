{
  "name": "@epicdm/saga-server",
  "version": "0.1.0",
  "description": "SAGA reference hub — Cloudflare Worker implementing the SAGA API (agents, documents, transfers)",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply saga-hub --local",
    "lint": "eslint src/ --ext .ts,.tsx,.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@epicdm/saga-sdk": "workspace:*",
    "@saga-standard/contracts": "workspace:*",
    "ai": "^6.0.141",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.14.0"
  },
  "author": "d7r LLC",
  "license": "Apache-2.0"
}
